---
// src/components/Solutions/WorkPlan.astro
// Plan de trabajo: lista fina con la etiqueta a la izquierda
const workSteps = [
  "Videollamada inicial",
  "Recepción de información",
  "Concepto de marca",
  "Feedback o correcciones",
  "Identidad visual",
  "Feedback o correcciones",
  "Recursos gráficos",
  "Feedback o correcciones",
  "Entrega de archivos finales",
  "Pago del 60% restante",
  "Videollamada de cierre (opcional)",
];
---

<section class="work-plan">
  <div class="work-plan__label text-micro text-muted">Plan de trabajo</div>
  <ol class="work-plan__list">
    {
      workSteps.map((step, i) => (
        <li class="work-plan__item" data-reveal={(i * 0.04).toFixed(2)}>
          <span class="text-muted">{String(i + 1).padStart(2, "0")}</span>
          <span>{step}</span>
        </li>
      ))
    }
  </ol>
  <a class="arrow-link work-plan__cta" href="/contact">Empezar →</a>
</section>

<style>
  .work-plan {
    display: grid;
    grid-template-columns: 27.5vw minmax(0, 560px);
    gap: 0 40px;
    padding: 120px 20px 140px;
    align-items: start;
  }

  .work-plan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(0, 0, 0, 0.14);
  }

  .work-plan__item {
    display: grid;
    grid-template-columns: 44px 1fr;
    padding: 12px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.14);
    font-family: var(--font-hanken);
    font-size: 13px;
    font-weight: 300;
    transition: padding 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .work-plan__item:hover {
    padding-left: 10px;
  }

  .work-plan__cta {
    grid-column: 2;
    margin: 28px 0 0;
    justify-self: end;
  }

  @media (max-width: 900px) {
    .work-plan {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-left: var(--container-padding);
      padding-right: var(--container-padding);
    }

    .work-plan__cta {
      grid-column: 1;
    }
  }
</style>
