---
// src/components/Contact/ContactForm.astro
import SocialLinks from "../UI/SocialLinks.astro";
import { contact } from "../../data/site";

const services = [
  { id: "web", label: "Web" },
  { id: "logotipo", label: "Branding" },
  { id: "redes-sociales", label: "Redes Sociales" },
  { id: "video", label: "Video" },
  { id: "asesoramiento", label: "Asesoramiento" },
];

// [id, name (parámetro de EmailJS), etiqueta, tipo, obligatorio]
const fields: [string, string, string, string, boolean][] = [
  ["name", "name", "Nombre", "text", true],
  ["email", "email", "Mail", "email", true],
  ["phone", "phone", "Teléfono", "tel", false],
  ["project-name", "project_name", "Nombre de tu empresa/marca", "text", false],
  ["has-website", "has_website", "¿Tienes web?", "text", false],
  ["budget", "budget", "Presupuesto", "text", false],
];
---

<section class="contact-form">
  <!-- Izquierda: datos y redes -->
  <aside class="contact-form__aside text-micro">
    <div class="contact-form__row" data-reveal="0">
      <span class="text-muted">Mail</span>
      <a href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
    <div class="contact-form__row" data-reveal="0.08">
      <span class="text-muted">Teléfono</span>
      <a href={contact.phoneHref}>{contact.phone}</a>
    </div>
    <div class="contact-form__row" data-reveal="0.16">
      <span class="text-muted">Estudio</span>
      <span>{contact.city}</span>
    </div>
    <div data-reveal="0.24">
      <SocialLinks size="small" />
    </div>
  </aside>

  <!-- Derecha: formulario -->
  <form class="contact-form__form" id="contact-form">
    <input type="hidden" name="services" id="selected-services" />

    <!-- Honeypot field - campo trampa para bots (invisible) -->
    <input type="text" name="website" id="website" class="honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="text-micro text-muted" id="services-label">¿Qué puedo hacer por ti?</div>
    <div class="contact-form__services" role="group" aria-labelledby="services-label">
      {
        services.map((service, i) => (
          <button
            type="button"
            class="service-button"
            data-service={service.id}
            aria-pressed="false"
            data-reveal={(0.1 + i * 0.05).toFixed(2)}
          >
            {service.label}
          </button>
        ))
      }
    </div>

    <div class="contact-form__grid">
      {
        fields.map(([id, name, label, type, required], i) => (
          <label class="contact-form__field" for={id} data-reveal={(0.2 + i * 0.05).toFixed(2)}>
            <span class="text-micro text-muted">
              {label}
              {required && " *"}
            </span>
            <input type={type} id={id} name={name} required={required} />
          </label>
        ))
      }
      <label class="contact-form__field contact-form__field--full" for="description" data-reveal="0.5">
        <span class="text-micro text-muted">Describe tu proyecto</span>
        <textarea id="description" name="description" rows="4"></textarea>
      </label>
    </div>

    <div class="contact-form__end">
      <p class="contact-form__message text-micro" id="form-message" aria-live="polite"></p>
      <button class="contact-form__send" type="submit">Enviar</button>
    </div>
  </form>
</section>

<style>
  .contact-form {
    display: grid;
    grid-template-columns: 27.5vw minmax(0, 720px);
    gap: 40px;
    padding: 0 20px 140px;
    align-items: start;
  }

  /* === IZQUIERDA === */
  .contact-form__aside {
    display: grid;
    gap: 22px;
    position: sticky;
    top: 90px;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: 70px 1fr;
  }

  .contact-form__row a {
    color: var(--color-black);
    text-decoration: none;
  }

  /* === FORMULARIO === */
  .contact-form__form {
    display: grid;
    gap: 22px;
  }

  .contact-form__services {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .service-button {
    font-family: var(--font-hanken);
    font-size: 12px;
    font-weight: 300;
    padding: 8px 14px;
    border: 1px solid rgba(0, 0, 0, 0.35);
    background: none;
    color: var(--color-black);
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s,
      border-color 0.3s;
  }

  .service-button:hover {
    border-color: var(--color-black);
  }

  .service-button[aria-pressed="true"] {
    background: var(--color-black);
    color: var(--color-grey);
    border-color: var(--color-black);
  }

  .contact-form__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px 32px;
    margin-top: 10px;
  }

  .contact-form__field {
    display: grid;
    gap: 6px;
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    font-family: var(--font-hanken);
    font-size: 14px;
    font-weight: 300;
    color: var(--color-black);
    background: none;
    border: 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.3);
    padding: 6px 0;
    border-radius: 0;
    outline: none;
    resize: vertical;
    transition: border-color 0.3s;
  }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    border-color: var(--color-black);
  }

  .contact-form__end {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
  }

  .contact-form__message {
    margin: 0;
    color: rgba(0, 0, 0, 0.5);
  }

  .contact-form__message--success {
    color: var(--color-black);
  }

  .contact-form__message--error {
    color: #b00020;
  }

  .contact-form__send {
    font-family: var(--font-hanken);
    font-size: 13px;
    letter-spacing: 0.04em;
    padding: 9px 22px;
    background: var(--color-black);
    color: var(--color-grey);
    border: 1px solid var(--color-black);
    cursor: pointer;
    transition:
      background 0.3s,
      color 0.3s;
  }

  .contact-form__send:hover {
    background: none;
    color: var(--color-black);
  }

  /* Honeypot: invisible para personas */
  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .contact-form {
      grid-template-columns: 1fr;
      gap: 24px;
      padding-left: var(--container-padding);
      padding-right: var(--container-padding);
    }

    .contact-form__aside {
      position: static;
    }

    .contact-form__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import emailjs from "@emailjs/browser";
  import { onPage } from "../../scripts/lifecycle";

  const PUBLIC_KEY = import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY;
  const SERVICE_ID = import.meta.env.PUBLIC_EMAILJS_SERVICE_ID;
  const TEMPLATE_ID = import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID;

  onPage(() => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null;
    const formMessage = document.getElementById("form-message");
    const hiddenInput = document.getElementById("selected-services") as HTMLInputElement | null;
    if (!form || !formMessage) return;

    const setMessage = (text: string, type: "loading" | "success" | "error") => {
      formMessage.textContent = text;
      formMessage.className = `contact-form__message text-micro contact-form__message--${type}`;
    };

    // Servicios (selección múltiple con aria-pressed)
    const serviceButtons = [...form.querySelectorAll<HTMLButtonElement>(".service-button")];
    const updateServices = () => {
      if (hiddenInput) {
        hiddenInput.value = serviceButtons
          .filter((b) => b.getAttribute("aria-pressed") === "true")
          .map((b) => b.dataset.service)
          .join(", ");
      }
    };
    serviceButtons.forEach((button) => {
      button.addEventListener("click", () => {
        button.setAttribute("aria-pressed", String(button.getAttribute("aria-pressed") !== "true"));
        updateServices();
        // Quitar el foco en dispositivos táctiles para que no se quede el estado visual
        button.blur();
      });
    });

    // Timestamp de cuando se cargó la página
    const pageLoadTime = Date.now();

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // === VALIDACIONES ANTI-SPAM ===

      // 1. Honeypot: Si el campo "website" está rellenado, es un bot
      const honeypot = document.getElementById("website") as HTMLInputElement | null;
      if (honeypot && honeypot.value !== "") {
        console.log("Spam detectado: honeypot rellenado");
        return; // Salir silenciosamente sin mostrar error
      }

      // 2. Rate limiting: No permitir más de 1 envío cada 60 segundos
      let lastSubmit: string | null = null;
      try {
        lastSubmit = localStorage.getItem("lastFormSubmit");
      } catch {}
      const now = Date.now();
      if (lastSubmit && now - parseInt(lastSubmit) < 60000) {
        setMessage("Por favor, espera un momento antes de enviar otro mensaje.", "error");
        return;
      }

      // 3. Tiempo mínimo: El usuario debe haber estado al menos 3 segundos en la página
      if (now - pageLoadTime < 3000) {
        console.log("Spam detectado: envío demasiado rápido");
        return; // Salir silenciosamente
      }

      // 4. Validación de contenido sospechoso
      const templateParams: Record<string, string> = {};
      new FormData(form).forEach((value, key) => {
        templateParams[key] = String(value);
      });

      // Detectar cadenas de texto aleatorio (más de 15 caracteres con alta entropía)
      const suspiciousPattern = /[A-Za-z]{15,}/;
      const textFields = [templateParams.name, templateParams.description, templateParams.project_name];

      for (const field of textFields) {
        if (field && suspiciousPattern.test(field)) {
          // Verificar si tiene muchas mayúsculas y minúsculas mezcladas (señal de spam)
          const upperCount = (field.match(/[A-Z]/g) || []).length;
          const lowerCount = (field.match(/[a-z]/g) || []).length;
          const totalLetters = upperCount + lowerCount;

          if (totalLetters > 15 && upperCount > totalLetters * 0.3 && lowerCount > totalLetters * 0.3) {
            console.log("Spam detectado: contenido sospechoso");
            return; // Salir silenciosamente
          }
        }
      }

      setMessage("Enviando mensaje...", "loading");

      try {
        // Enviar el formulario (sin el campo honeypot)
        delete templateParams.website;
        await emailjs.send(SERVICE_ID, TEMPLATE_ID, templateParams, { publicKey: PUBLIC_KEY });

        setMessage("¡Mensaje enviado con éxito! Te responderé pronto.", "success");
        form.reset();
        try {
          localStorage.setItem("lastFormSubmit", now.toString());
        } catch {}

        // Limpiar botones de servicios
        serviceButtons.forEach((btn) => btn.setAttribute("aria-pressed", "false"));
        updateServices();
      } catch (error) {
        setMessage("Hubo un error al enviar el mensaje. Por favor, inténtalo de nuevo.", "error");
        console.error("Error:", error);
      }
    });
  });
</script>
