---
// src/components/Common/WorkShowcase.astro
// Sección de proyectos fijada al scroll (inspirada en huyml.co). Se usa en la home y en /portfolio.
// La imagen central es el proyecto activo; la anterior se va arriba a la derecha y la siguiente
// entra por abajo a la izquierda; el resto se apilan detrás como un mazo.
import { getProjects, getPalette, displayUrl } from "../../lib/projects";
import { optimizeHygraphImage } from "../../lib/imageUtils";

export interface Props {
  showAllLink?: boolean;
}

const { showAllLink = false } = Astro.props;

const projects = await getProjects();
const palettes = await Promise.all(projects.map((p) => getPalette(p.mainImage.url)));
const total = projects.length;
const pad = (n: number) => String(n).padStart(2, "0");
const cleanTitle = (title: string) => title.replace(/\s+/g, " ").trim();
---

<section class="work" style={`--work-count: ${total}`} data-work>
  <div class="work__stick">
    <!-- Imágenes -->
    <div class="work__stage">
      {
        projects.map((project, i) => (
          <a
            class="work__card"
            href={`/portfolio/${project.slug}`}
            data-index={i}
            data-palette={JSON.stringify(palettes[i])}
            aria-label={cleanTitle(project.title)}
          >
            <img
              src={optimizeHygraphImage(project.mainImage.url, { width: 840, quality: 75 })}
              alt={cleanTitle(project.title)}
              loading={i < 4 ? "eager" : "lazy"}
              decoding="async"
            />
          </a>
        ))
      }
    </div>

    <!-- Izquierda: datos del proyecto activo -->
    <div class="work__info text-micro">
      {
        projects.map((project, i) => (
          <div class:list={["work__info-item", { "is-active": i === 0 }]} data-index={i}>
            <div class="work__pair">
              <span class="text-muted">Servicios</span>
              <span>
                {project.services.map((service, k) => (
                  <>
                    {k > 0 && <br />}
                    {service}
                  </>
                ))}
              </span>
            </div>
            <div class="work__pair work__pair--wide">
              <span class="text-muted">Sector</span>
              <span>{project.sector}</span>
            </div>
            <div class="work__pair" />
            <div class="work__pair work__pair--wide">
              <span class="text-muted">Estudio</span>
              <span>
                Lexmake, Barcelona
                {project.websiteUrl && (
                  <>
                    <br />
                    <a href={project.websiteUrl} target="_blank" rel="noopener">
                      {displayUrl(project.websiteUrl)}
                    </a>
                  </>
                )}
              </span>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Abajo: número del proyecto activo -->
    <div class="work__counter" aria-hidden="true">
      <span class="text-micro text-muted">Proyectos</span>
      <span class="work__num"><span>01</span></span>
      <span class="text-micro">/{pad(total)}</span>
    </div>

    <!-- Derecha: lista de proyectos -->
    <div class="work__list">
      {
        projects.map((project, i) => (
          <a
            class:list={["work__item", { "is-active": i === 0 }]}
            href={`/portfolio/${project.slug}`}
            data-index={i}
          >
            <span class="work__item-cat">{project.services.join(", ")}</span>
            <span class="work__item-title">{cleanTitle(project.title)}</span>
            <span class="work__item-line" />
            <span class="work__item-desc">{project.shortDescription}</span>
          </a>
        ))
      }
    </div>

    <!-- Colores de la portada -->
    <div class="work__swatches" aria-hidden="true">
      {palettes[0].map((color) => <i style={`background: ${color}`} />)}
    </div>

    <!-- Móvil: categoría, nombre y colores bajo la imagen -->
    <div class="work__mobile-info text-micro" aria-hidden="true">
      <span class="text-muted work__mobile-cat">{projects[0].services.join(", ")}</span>
      <span class="work__mobile-title">{cleanTitle(projects[0].title)}</span>
      <div class="work__mobile-swatches">
        {palettes[0].map((color) => <i style={`background: ${color}`} />)}
      </div>
    </div>

    <div class="work__foot">
      <span class="text-micro text-muted">Scroll</span>
      {showAllLink && <a href="/portfolio" class="view-more-link">Ver todos</a>}
    </div>
  </div>
</section>

<style>
  .work {
    position: relative;
    height: calc(var(--work-count) * 42vh + 100vh);
  }

  .work__stick {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    perspective: 1400px;
    /* fondo propio: el contador se mezcla (mix-blend-mode) dentro de este contexto */
    background: var(--color-grey);
  }

  .work__stage {
    position: absolute;
    inset: 0;
  }

  .work__card {
    position: absolute;
    left: 49.2%;
    top: 50.5%;
    width: 23.7vw;
    max-width: 420px;
    aspect-ratio: 1.235;
    display: block;
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
    backface-visibility: hidden;
    cursor:
      url("/assets/cursor/BLANCO.svg") 32 32,
      pointer;
  }

  .work__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: #d9d9d9;
    box-shadow: -6px 0 0 rgba(0, 0, 0, 0.04);
  }

  /* Hasta que el JS coloca las tarjetas, solo se ve la primera */
  .work__card:not(:first-child) {
    opacity: 0;
  }

  .work.is-ready .work__card {
    opacity: 1;
  }

  /* === INFO IZQUIERDA === */
  .work__info {
    position: absolute;
    left: 0;
    top: 41.6%;
    z-index: 3;
  }

  .work__info-item {
    display: none;
    grid-template-columns: repeat(2, auto);
    gap: 68px 0;
  }

  .work__info-item.is-active {
    display: grid;
  }

  .work__pair {
    display: grid;
    grid-template-columns: 54px 1fr;
    padding-left: 20px;
    min-width: 178px;
  }

  .work__pair--wide {
    grid-template-columns: 90px 1fr;
    padding-left: 0;
    min-width: 240px;
  }

  .work__pair a {
    color: var(--color-black);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* === NÚMERO === */
  /* Por encima de las tarjetas (z-index hasta 100) y con color inverso:
     blanco + difference = casi negro sobre el gris y claro sobre imágenes oscuras */
  .work__counter {
    position: absolute;
    left: 13.75vw;
    bottom: 24px;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    pointer-events: none;
    color: #fff;
    mix-blend-mode: difference;
  }

  .work__counter .text-micro {
    margin-top: 8px;
    color: #fff;
  }

  /* Máscara del número: se alarga por arriba (--num-extra) sin mover el número,
     para que el que sale suba más antes de cortarse */
  .work__num {
    --num-extra: 60px;
    font-family: var(--font-hanken);
    font-weight: 300;
    font-size: 180px;
    line-height: 153px;
    letter-spacing: -7.2px;
    height: calc(153px + var(--num-extra));
    padding-top: var(--num-extra);
    margin-top: calc(-1 * var(--num-extra));
    overflow: hidden;
    display: block;
    font-variant-numeric: tabular-nums;
  }

  .work__num span {
    display: block;
    transition: transform 0.6s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* === LISTA DERECHA === */
  .work__list {
    position: absolute;
    left: 80vw;
    top: 0;
    width: 246px;
    margin-left: -123px;
    z-index: 3;
    will-change: transform;
    transform: translateY(calc(50vh - 50px));
  }

  .work__item {
    height: 173px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0.28;
    transition: opacity 0.45s ease;
    color: var(--color-black);
    text-decoration: none;
    font-family: var(--font-hanken);
    font-size: 10px;
    line-height: 13px;
    font-weight: 300;
    letter-spacing: 0.1px;
  }

  .work__item:hover {
    opacity: 0.7;
  }

  .work__item.is-active,
  .work__item.is-active:hover {
    opacity: 1;
    cursor:
      url("/assets/cursor/BLANCO.svg") 32 32,
      pointer;
  }

  .work__item-cat {
    color: rgba(31, 31, 31, 0.52);
  }

  .work__item-title {
    font-size: 16px;
    line-height: 16px;
    letter-spacing: 0.16px;
    text-transform: uppercase;
    margin-top: 6px;
  }

  .work__item-line {
    width: 12px;
    height: 1px;
    background: currentColor;
    margin: 16px 0 20px;
  }

  .work__item-desc {
    max-width: 246px;
  }

  /* === COLORES === */
  .work__swatches {
    position: absolute;
    right: 20px;
    top: 50%;
    display: flex;
    gap: 6px;
    z-index: 3;
    transform: translateY(-50%);
  }

  .work__swatches i,
  .work__mobile-swatches i {
    width: 12px;
    height: 12px;
    display: block;
    transition: background 0.5s;
  }

  .work__foot {
    position: absolute;
    left: 20px;
    right: 20px;
    bottom: 20px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    z-index: 3;
  }

  .work__foot .view-more-link {
    font-size: 20px;
  }

  .work__mobile-info {
    display: none;
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .work__card {
      left: 50%;
      top: 42%;
      width: 72vw;
      max-width: none;
    }

    .work__info,
    .work__list,
    .work__swatches {
      display: none;
    }

    .work__counter {
      left: var(--container-padding);
      top: 84px;
      bottom: auto;
    }

    .work__num {
      --num-extra: 28px;
      font-size: 84px;
      line-height: 72px;
      height: calc(72px + var(--num-extra));
      letter-spacing: -3px;
    }

    .work__mobile-info {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 8px;
      position: absolute;
      left: 24px;
      right: 24px;
      bottom: 76px;
      z-index: 120;
    }

    .work__mobile-title {
      font-size: 16px;
      line-height: 1.1;
      text-transform: uppercase;
    }

    .work__mobile-swatches {
      display: flex;
      gap: 6px;
    }

    .work__foot > .text-micro:first-child {
      visibility: hidden;
    }
  }
</style>

<script>
  import { onPage, prefersReducedMotion, clamp } from "../../scripts/lifecycle";

  const pad = (n: number) => String(n).padStart(2, "0");
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  function initShowcase(section: HTMLElement) {
    const reduce = prefersReducedMotion();
    const cards = [...section.querySelectorAll<HTMLAnchorElement>(".work__card")];
    const items = [...section.querySelectorAll<HTMLAnchorElement>(".work__item")];
    const infos = [...section.querySelectorAll<HTMLElement>(".work__info-item")];
    const list = section.querySelector<HTMLElement>(".work__list")!;
    const num = section.querySelector<HTMLElement>(".work__num span")!;
    const swatches = [...section.querySelectorAll<HTMLElement>(".work__swatches i, .work__mobile-swatches i")];
    const mobileCat = section.querySelector<HTMLElement>(".work__mobile-cat")!;
    const mobileTitle = section.querySelector<HTMLElement>(".work__mobile-title")!;
    const palettes = cards.map((c) => JSON.parse(c.dataset.palette || "[]") as string[]);
    const n = cards.length;

    let current = 0; // posición suavizada (0 … n-1)
    let active = 0; // el HTML ya llega con el primer proyecto activo
    let numTimer = 0;

    const setActive = (i: number) => {
      active = i;
      items.forEach((el, k) => el.classList.toggle("is-active", k === i));
      infos.forEach((el, k) => el.classList.toggle("is-active", k === i));
      mobileCat.textContent = items[i].querySelector(".work__item-cat")?.textContent || "";
      mobileTitle.textContent = items[i].querySelector(".work__item-title")?.textContent || "";
      swatches.forEach((el, k) => (el.style.background = palettes[i][k % 3] || ""));

      // El número sale hacia arriba y entra el nuevo desde abajo
      window.clearTimeout(numTimer);
      if (reduce) {
        num.textContent = pad(i + 1);
        return;
      }
      num.style.transform = "translateY(calc(-100% - var(--num-extra)))";
      numTimer = window.setTimeout(() => {
        num.textContent = pad(i + 1);
        num.style.transition = "none";
        num.style.transform = "translateY(100%)";
        void num.offsetHeight;
        num.style.transition = "";
        num.style.transform = "";
      }, 300);
    };

    // Scroll hasta el proyecto j
    const jump = (j: number) => {
      const top = window.scrollY + section.getBoundingClientRect().top;
      const span = section.offsetHeight - window.innerHeight;
      window.scrollTo({ top: top + span * (j / Math.max(1, n - 1)), behavior: reduce ? "auto" : "smooth" });
    };

    // Clic en un proyecto que no es el activo: scroll hasta él (en vez de abrir la ficha)
    const onClick = (e: Event) => {
      const el = (e.currentTarget as HTMLElement);
      const i = Number(el.dataset.index);
      if (Math.abs(i - current) > 0.5) {
        e.preventDefault();
        jump(i);
      }
    };
    [...cards, ...items].forEach((el) => el.addEventListener("click", onClick));

    const render = () => {
      const rect = section.getBoundingClientRect();
      const span = section.offsetHeight - window.innerHeight;
      const target = clamp(-rect.top / span, 0, 1) * (n - 1);
      current = reduce ? target : lerp(current, target, 0.09);
      if (Math.abs(current - target) < 0.0005) current = target;

      const vw = window.innerWidth / 100;
      const vh = window.innerHeight / 100;
      const mobile = window.innerWidth <= 768;

      cards.forEach((card, i) => {
        // Geometría medida en huyml: anterior arriba-dcha, siguiente abajo-izq, el resto en mazo
        const a = i - current;
        const ab = Math.abs(a);
        const t = Math.min(ab, 1);
        const extra = Math.max(0, ab - 1);
        let x: number;
        let y: number;
        if (a < 0) {
          x = (mobile ? 16 : 10.2) * vw * t + extra * (mobile ? 12 : 30);
          y = -(mobile ? 48 : 45) * vh * t - extra * (mobile ? 10 : 22);
        } else {
          x = -(mobile ? 22 : 19) * vw * t - extra * (mobile ? 12 : 30);
          y = (mobile ? 64 : 55) * vh * t + extra * (mobile ? 10 : 22);
        }
        const rz = 1 + t * 4.5 + Math.min(extra, 3) * 1.2;
        const ry = -6 + t * (a < 0 ? -8 : 8);
        const z = -t * 40 - Math.min(extra, 5) * 30;
        card.style.transform = `translate(-50%, -50%) perspective(1400px) translate3d(${x}px, ${y}px, ${z}px) rotateY(${ry}deg) rotateZ(${rz}deg)`;
        card.style.opacity = extra > 4 ? "0" : "1";
        card.style.zIndex = String(100 - Math.round(ab * 10));
        card.tabIndex = Math.abs(a) < 0.5 ? 0 : -1;
      });

      // La lista se desplaza para que el activo quede a la altura de la imagen central
      list.style.transform = `translateY(${window.innerHeight * 0.5 - 50 - current * 173}px)`;

      const i = clamp(Math.round(current), 0, n - 1);
      if (i !== active) setActive(i);
    };

    // El bucle solo corre mientras la sección está en pantalla
    let raf = 0;
    const loop = () => {
      render();
      raf = requestAnimationFrame(loop);
    };
    const observer = new IntersectionObserver(
      ([entry]) => {
        cancelAnimationFrame(raf);
        if (entry.isIntersecting) raf = requestAnimationFrame(loop);
      },
      { rootMargin: "50px 0px" }
    );
    observer.observe(section);

    // Colocar todo antes del primer frame
    current = clamp(-section.getBoundingClientRect().top / (section.offsetHeight - window.innerHeight), 0, 1) * (n - 1);
    render();
    section.classList.add("is-ready");

    return () => {
      observer.disconnect();
      cancelAnimationFrame(raf);
      window.clearTimeout(numTimer);
      [...cards, ...items].forEach((el) => el.removeEventListener("click", onClick));
    };
  }

  onPage(() => {
    const cleanups = [...document.querySelectorAll<HTMLElement>("[data-work]")].map(initShowcase);
    return () => cleanups.forEach((fn) => fn());
  });
</script>
