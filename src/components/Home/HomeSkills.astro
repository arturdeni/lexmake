---
// src/components/Home/HomeSkills.astro
---

<section class="home-skills">
  <div class="home-skills__container">
    <!-- Sección MY SKILLS -->
    <div class="home-skills__skills-section">
      <h4 class="skills-header" data-reveal>MY SKILLS</h4>

      <div class="skills-grid">
        <!-- Fila 1 -->
        <div class="skill-item skill-item--large">Photoshop</div>
        <div class="skill-item skill-item--cursive">Adobe illustrator</div>

        <!-- Fila 2 -->
        <div class="skill-item skill-item--large">AFTER EFFECTS</div>
        <div class="skill-item skill-item--cursive">Premier Pro</div>
        <div class="skill-item skill-item--large">Dimensions</div>

        <!-- Fila 3 -->
        <div class="skill-item skill-item--cursive">indesign</div>
        <div class="skill-item skill-item--large">FIGMA</div>
        <div class="skill-item skill-item--cursive">Strikingly</div>
        <div class="skill-item skill-item--large">WORDPRESS</div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-skills {
    background-color: var(--color-grey);
    position: relative;
    z-index: 10;
    padding: var(--spacing-xl) 0;
  }

  .home-skills__container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    display: flex;
    flex-direction: column;
  }

  /* === SKILLS SECTION === */
  .home-skills__skills-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xxxl);
  }

  .skills-header {
    text-align: center;
    margin: 0;
    font-size: var(--h5-size);
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  /* === SKILLS GRID === */
  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-sm) var(--spacing-xl);
    max-width: 800px;
    margin: 0 auto;
  }

  .skill-item {
    font-size: var(--h4-size);
    line-height: 1.2;
    margin: 0;
    white-space: nowrap;
  }

  .skill-item--large {
    font-family: var(--font-hanken);
    font-weight: 500;
    font-style: normal;
    text-transform: uppercase;
  }

  .skill-item--cursive {
    font-family: var(--font-gallery);
    font-weight: 400;
    font-style: italic;
  }

  /* === RESPONSIVE === */
  @media (max-width: 1024px) {
    .skills-grid {
      gap: var(--spacing-md) var(--spacing-lg);
    }

    .skill-item {
      font-size: calc(var(--h4-size) * 0.8);
    }
  }

  @media (max-width: 768px) {
    .home-skills {
      padding: var(--spacing-xl) 0;
    }

    .skills-grid {
      gap: var(--spacing-md);
      text-align: center;
    }

    .skill-item {
      font-size: calc(var(--h4-size) * 0.7);
    }
  }

  @media (max-width: 480px) {
    .skill-item {
      font-size: calc(var(--h4-size) * 0.6);
    }
  }

  .skill-item {
    will-change: transform, filter, opacity;
  }
</style>

<script>
  // MY SKILLS: cada palabra pasa de desenfocada a nítida mientras haces scroll,
  // entrando de lados alternos
  import { onPage, prefersReducedMotion, clamp } from "../../scripts/lifecycle";

  onPage(() => {
    const grid = document.querySelector<HTMLElement>(".skills-grid");
    if (!grid || prefersReducedMotion()) return;
    const skills = [...grid.querySelectorAll<HTMLElement>(".skill-item")];
    const n = skills.length;

    const update = () => {
      const r = grid.getBoundingClientRect();
      const progress = clamp(
        (window.innerHeight * 0.92 - r.top) / (window.innerHeight * 0.55 + r.height * 0.6),
        0,
        1
      );
      skills.forEach((el, i) => {
        const q = clamp(progress * (n + 2) - i, 0, 1);
        const dir = i % 2 ? 1 : -1;
        el.style.opacity = (0.12 + 0.88 * q).toFixed(3);
        el.style.filter = q < 1 ? `blur(${((1 - q) * 8).toFixed(1)}px)` : "";
        el.style.transform =
          q < 1 ? `translate3d(${(dir * (1 - q) * 70).toFixed(1)}px, ${((1 - q) * 14).toFixed(1)}px, 0)` : "";
      });
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    return () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
    };
  });
</script>
