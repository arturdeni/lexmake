---
// src/components/Resources/ResourcesBlocks.astro
const resources = [
  {
    title: "RETÍCULA ILLUSTRATOR LOGO MAKER",
    description:
      "Plantilla base para construir logotipos con precisión, coherencia visual y control total de proporciones en Illustrator.",
    image: "/assets/resources/reticulas.webp",
    downloadLink: "/assets/resources/RETICULAS_LEXMAKE.ai",
  },
  {
    title: "BRANDING PRESENTATION MOCKUPS",
    description:
      "Mockups listos para presentar tu identidad de marca de forma clara, atractiva y profesional en distintos soportes.",
    image:
      "/assets/resources/branding.webp",
    downloadLink: "https://drive.google.com/AQUI_TU_ENLACE_DE_DESCARGA", // TODO: falta el enlace real (ver docs/redesign-pendientes.md)
  },
  {
    title: "INITIAL BRIEF TO MAKE A WEBSITE",
    description:
      "Documento guía para definir objetivos, estructura y necesidades clave antes de iniciar el diseño de un sitio web.",
    image: "/assets/resources/briefing-img.webp",
    downloadLink: "/assets/resources/BREIFINGS.zip",
  },
  {
    title: "LOGO PROPOSAL PRESENTATION",
    description:
      "Documento diseñado para presentar propuestas de logotipo de forma clara, estratégica y profesional, explicando el concepto, las decisiones visuales y su correcta aplicación.",
    image:
      "/assets/resources/logoProposal.webp",
    downloadLink: "/assets/resources/Presentación propuesta Logo.ai.zip",
  },
];
---

<section class="resources-grid">
  {
    resources.map((resource, i) => (
      <article class="resource" data-reveal={(i * 0.1).toFixed(2)}>
        <div class="resource__image">
          <img src={resource.image} alt={resource.title} loading="lazy" />
        </div>
        <span class="text-micro text-muted">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="resource__title">{resource.title}</h3>
        <p class="text-micro resource__description">{resource.description}</p>
        <a class="text-micro resource__download" href={resource.downloadLink} target="_blank" rel="noopener">
          Descargar →
        </a>
      </article>
    ))
  }
</section>

<style>
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    padding: 0 20px 140px;
  }

  .resource {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .resource__image {
    aspect-ratio: 0.8;
    overflow: hidden;
    background: #e2e2e2;
    margin-bottom: 8px;
  }

  .resource__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .resource:hover .resource__image img {
    transform: scale(1.04);
  }

  .resource__title {
    margin: 0;
    font-family: var(--font-hanken);
    font-weight: 300;
    font-size: 16px;
    line-height: 18px;
    text-transform: uppercase;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .resource:hover .resource__title {
    transform: translateX(6px);
  }

  .resource__description {
    margin: 0;
    max-width: 280px;
  }

  .resource__download {
    color: var(--color-black);
    text-decoration: underline;
    text-underline-offset: 2px;
    width: max-content;
  }

  .resource__download:hover {
    opacity: 0.5;
  }

  @media (max-width: 900px) {
    .resources-grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px 16px;
      padding: 0 var(--container-padding) 100px;
    }
  }

  @media (max-width: 768px) {
    .resource__title {
      font-size: 14px;
      line-height: 16px;
    }
  }
</style>
