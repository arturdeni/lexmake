---
// src/components/Layout/MobileMenu.astro
// Menú móvil a pantalla completa. Se renderiza al final del <body> (fuera del <header>):
// dentro del header, su backdrop-filter haría que el position:fixed quedara encerrado en él.
import SocialLinks from "../UI/SocialLinks.astro";
import { contact } from "../../data/site";
---

<div class="mobile-overlay" id="mobile-menu" aria-hidden="true">
  <nav class="mobile-nav" aria-label="Menú">
    <ul class="mobile-nav__list">
      <li><a href="/solutions" class="mobile-nav__link">SOLUTIONS</a></li>
      <li><a href="/portfolio" class="mobile-nav__link mobile-nav__link--cursive">PORTFOLIO</a></li>
      <li><a href="/resources" class="mobile-nav__link">RESOURCES</a></li>
      <li><a href="/contact" class="mobile-nav__button">CONTACT</a></li>
    </ul>

    <div class="mobile-contact">
      <div class="mobile-contact__data">
        <span class="text-micro text-muted">Contacto</span>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={contact.phoneHref}>{contact.phone}</a>
        <span class="text-muted">{contact.city}</span>
      </div>
      <SocialLinks class="mobile-contact__social" />
    </div>
  </nav>
</div>

<style>
  .mobile-overlay {
    position: fixed;
    inset: 0;
    background-color: var(--color-grey);
    z-index: 900;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      visibility 0.4s ease;
  }

  .mobile-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .mobile-nav {
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 110px 24px max(36px, env(safe-area-inset-bottom, 0px));
  }

  .mobile-nav__list {
    list-style: none;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin: auto 0;
  }

  /* Entrada escalonada con desenfoque */
  .mobile-nav__list li,
  .mobile-contact {
    opacity: 0;
    filter: blur(10px);
    transform: translateY(24px);
    transition:
      opacity 0.6s ease,
      filter 0.6s ease,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-overlay.active .mobile-nav__list li,
  .mobile-overlay.active .mobile-contact {
    opacity: 1;
    filter: none;
    transform: none;
  }

  .mobile-overlay.active li:nth-child(1) {
    transition-delay: 0.15s;
  }
  .mobile-overlay.active li:nth-child(2) {
    transition-delay: 0.23s;
  }
  .mobile-overlay.active li:nth-child(3) {
    transition-delay: 0.31s;
  }
  .mobile-overlay.active li:nth-child(4) {
    transition-delay: 0.39s;
  }
  .mobile-overlay.active .mobile-contact {
    transition-delay: 0.45s;
  }

  .mobile-nav__link {
    font-family: var(--font-hanken);
    font-size: 24px;
    font-weight: 500;
    color: var(--color-black);
    text-decoration: none;
    display: block;
    padding: 6px;
  }

  .mobile-nav__link--cursive {
    font-family: var(--font-gallery);
    font-style: italic;
    font-weight: 400;
  }

  .mobile-nav__button {
    font-family: var(--font-hanken);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-grey);
    background-color: var(--color-black);
    text-decoration: none;
    padding: 9px 18px;
    border: 1px solid var(--color-black);
    display: inline-block;
    margin-top: 18px;
    transition: all 0.3s ease;
  }

  .mobile-nav__button:hover {
    background-color: var(--color-grey);
    color: var(--color-black);
  }

  .mobile-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .mobile-contact__data {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
    font-weight: 300;
    line-height: 1.3;
  }

  .mobile-contact__data a {
    color: var(--color-black);
    text-decoration: none;
  }

  .mobile-contact__data .text-micro {
    margin-bottom: 6px;
  }

  .mobile-contact__social {
    justify-content: center;
  }

  @media (min-width: 769px) {
    .mobile-overlay {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav__list li,
    .mobile-contact {
      filter: none;
      transform: none;
      transition: opacity 0.3s ease;
    }
  }
</style>

<script>
  // Un único juego de listeners por delegación: el botón y el overlay se sustituyen al navegar
  const setOpen = (open: boolean) => {
    const toggle = document.querySelector<HTMLElement>(".mobile-toggle");
    const overlay = document.getElementById("mobile-menu");
    toggle?.classList.toggle("active", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    overlay?.classList.toggle("active", open);
    overlay?.setAttribute("aria-hidden", String(!open));
    document.documentElement.classList.toggle("menu-open", open);
    document.body.style.overflow = open ? "hidden" : "";
  };

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest(".mobile-toggle")) {
      setOpen(!document.documentElement.classList.contains("menu-open"));
    } else if (target.closest("#mobile-menu a")) {
      setOpen(false);
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Al navegar con el ClientRouter, cerrar el menú
  document.addEventListener("astro:before-swap", () => setOpen(false));
</script>
