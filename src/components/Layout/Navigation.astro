---
// src/components/Layout/Navigation.astro
// Navegación principal para desktop. La sección activa lleva una flecha delante.
import Button from "../UI/Button.astro";

const links = [
  { href: "/solutions", label: "SOLUTIONS" },
  { href: "/portfolio", label: "PORTFOLIO" },
  { href: "/resources", label: "RESOURCES" },
];

const path = Astro.url.pathname;
---

<nav class="navigation">
  <ul class="nav-list">
    {
      links.map((link) => {
        const active = path === link.href || path.startsWith(`${link.href}/`);
        return (
          <li class="nav-item">
            <a
              href={link.href}
              class:list={["nav-link", { "is-active": active }]}
              aria-current={active ? "page" : undefined}
            >
              <span class="nav-link__arrow" aria-hidden="true">→</span>
              {link.label}
            </a>
          </li>
        );
      })
    }
  </ul>

  <!-- Botón Contact usando el componente Button -->
  <Button href="/contact" size="nav" class="contact-button-wrapper">CONTACT</Button>
</nav>

<style>
  .navigation {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    position: absolute;
    left: 0;
    right: 0;
    padding: 0 var(--container-padding);
    pointer-events: none; /* Para que no interfiera con clics */
  }

  .navigation > * {
    pointer-events: auto; /* Reactivar eventos para elementos hijos */
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 36px;
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    font-family: var(--font-hanken);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-black);
    text-decoration: none;
    display: block;
    position: relative;
    transition: opacity 0.3s ease;
  }

  .nav-link:hover {
    opacity: 0.45;
  }

  .nav-link__arrow {
    position: absolute;
    right: 100%;
    top: 50%;
    margin-right: 8px;
    font-weight: 300;
    opacity: 0;
    transform: translate(-6px, -50%);
    transition:
      opacity 0.4s,
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link.is-active .nav-link__arrow {
    opacity: 1;
    transform: translate(0, -50%);
  }

  /* Wrapper para el botón Contact alineado a la derecha */
  .contact-button-wrapper {
    margin-left: auto;
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .navigation {
      display: none;
    }
  }
</style>
