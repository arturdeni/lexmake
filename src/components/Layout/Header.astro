---
// src/components/Layout/Header.astro
// Cabecera compacta: se esconde al bajar y reaparece al subir.
// El menú móvil (MobileMenu.astro) vive fuera del <header>: si estuviera dentro,
// el backdrop-filter de la cabecera lo encerraría en sus 56px.
import Navigation from "./Navigation.astro";
---

<header class="header">
  <div class="header__container">
    <!-- Logo -->
    <div class="header__logo">
      <a href="/" class="logo-link">
        <img src="/logo.svg" alt="LexMake" class="logo" />
      </a>
    </div>

    <!-- Desktop Navigation -->
    <Navigation />

    <!-- Mobile Menu Toggle -->
    <button
      class="mobile-toggle"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 901; /* por encima del menú móvil (900) para que se vea el botón de cerrar */
    background-color: var(--color-grey);
    transition:
      transform 0.7s cubic-bezier(0.76, 0, 0.24, 1),
      background-color 0.5s ease,
      backdrop-filter 0.5s ease;
  }

  .header.is-scrolled {
    background-color: rgba(237, 237, 237, 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .header.is-hidden {
    transform: translateY(-100%);
  }

  .header__container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  /* === LOGO === */
  .header__logo {
    flex-shrink: 0;
  }

  .logo-link {
    display: block;
    text-decoration: none;
  }

  .logo {
    height: 28px;
    width: auto;
    display: block;
  }

  /* === MOBILE TOGGLE === */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    gap: 6px;
    position: relative;
  }

  .hamburger-line {
    width: 24px;
    height: 2px;
    background-color: var(--color-black);
    transition: all 0.3s ease;
    transform-origin: center;
  }

  /* Animación de hamburger a cruz */
  .mobile-toggle.active {
    gap: 9px;
  }

  .mobile-toggle.active .hamburger-line:first-child {
    transform: rotate(45deg) translate(4px, 4px);
  }

  .mobile-toggle.active .hamburger-line:last-child {
    transform: rotate(-45deg) translate(4px, -4px);
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }

    /* Compensar el header fixed */
    :global(body) {
      padding-top: 80px;
    }
  }

  @media (min-width: 769px) {
    :global(body) {
      padding-top: 56px;
    }
  }
</style>

<script>
  // Cabecera: fondo translúcido al hacer scroll y se esconde al bajar.
  // Un único listener para toda la sesión: la cabecera se busca en cada evento
  // porque el ClientRouter la sustituye al navegar.
  let lastY = window.scrollY;
  let ticking = false;

  const update = () => {
    ticking = false;
    const header = document.querySelector<HTMLElement>(".header");
    if (!header) return;
    const y = window.scrollY;
    header.classList.toggle("is-scrolled", y > 40);
    if (Math.abs(y - lastY) > 6) {
      const menuOpen = document.documentElement.classList.contains("menu-open");
      header.classList.toggle("is-hidden", y > lastY && y > 200 && !menuOpen);
      lastY = y;
    }
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    },
    { passive: true }
  );

  document.addEventListener("astro:page-load", () => {
    lastY = window.scrollY;
    update();
  });
</script>
