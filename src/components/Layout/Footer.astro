---
// src/components/Layout/Footer.astro
import SocialLinks from "../UI/SocialLinks.astro";
import { contact } from "../../data/site";
---

<footer class="footer">
  <div class="footer__container">
    <!-- Logo -->
    <div class="footer__logo">
      <a href="/" class="logo-link" aria-label="Lexmake Home">
        <div class="logo-circle">
          <img src="/favicon-grande.png" alt="Lexmake Logo" class="logo-img" />
        </div>
      </a>
    </div>

    <!-- Navigation Links -->
    <nav class="footer__nav">
      <ul class="footer__nav-list">
        <li><a href="/solutions" class="footer__nav-link">Soluciones</a></li>
        <li><a href="/portfolio" class="footer__nav-link">Portfolio</a></li>
        <li><a href="/resources" class="footer__nav-link">Recursos</a></li>
      </ul>
    </nav>

    <!-- Contact Info -->
    <div class="footer__contact">
      <a href={`mailto:${contact.email}`} class="footer__contact-link">{contact.email}</a>
      <a href={contact.phoneHref} class="footer__contact-link">{contact.phone}</a>
    </div>

    <!-- Social Links -->
    <SocialLinks class="footer__social" />
  </div>

  <!-- Bottom Section -->
  <div class="footer__bottom">
    <div class="footer__bottom-container">
      <p class="footer__copyright">
        © 2025 Lexmake. Todos los derechos reservados.
      </p>
      <div class="footer__legal">
        <a href="/privacy-policy" class="footer__legal-link"
          >POLÍTICA PRIVACIDAD</a
        >
        <a href="/terms-and-conditions" class="footer__legal-link"
          >TÉRMINOS Y CONDICIONES</a
        >
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-grey);
    padding: var(--spacing-xxxl) 0 0;
    margin-top: var(--spacing-xl);
  }

  .footer__container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: start;
    gap: var(--spacing-xxl);
    padding-bottom: var(--spacing-xxl);
  }

  /* === LOGO === */
  .footer__logo {
    flex-shrink: 0;
  }

  .logo-link {
    display: block;
    text-decoration: none;
  }

  .logo-circle {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    background-color: var(--color-black);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logo-link:hover .logo-circle {
    transform: scale(1.05);
  }

  /* === NAVIGATION === */
  .footer__nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .footer__nav-link {
    font-family: var(--font-hanken);
    font-size: var(--body-size);
    font-weight: 300;
    color: var(--color-black);
    text-decoration: none;
    transition: font-family 0.3s ease;
  }

  .footer__nav-link:hover {
    font-family: var(--font-gallery);
    font-style: italic;
  }

  /* === CONTACT === */
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    text-align: right;
  }

  .footer__contact-link {
    font-family: var(--font-hanken);
    font-size: var(--body-size);
    font-weight: 300;
    color: var(--color-black);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .footer__contact-link:hover {
    opacity: 0.7;
  }

  /* === SOCIAL LINKS === */
  .footer__social {
    display: flex;
    gap: var(--spacing-md);
    align-items: center;
  }


  /* === BOTTOM SECTION === */
  .footer__bottom {
    border-top: 1px solid var(--color-black);
    padding: var(--spacing-lg) 0;
  }

  .footer__bottom-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-lg);
  }

  .footer__copyright {
    font-family: var(--font-hanken);
    font-size: var(--body-size);
    font-weight: 300;
    color: var(--color-black);
    margin: 0;
  }

  .footer__legal {
    display: flex;
    gap: var(--spacing-xxl);
  }

  .footer__legal-link {
    font-family: var(--font-hanken);
    font-size: var(--body-size);
    font-weight: 300;
    color: var(--color-black);
    text-decoration: none;
    transition: opacity 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .footer__legal-link:hover {
    opacity: 0.7;
  }

  /* === RESPONSIVE === */
  @media (max-width: 768px) {
    .footer {
      padding: var(--spacing-xl) 0 0;
      margin-top: var(--spacing-xl);
    }

    .footer__container {
      grid-template-columns: 1fr;
      gap: var(--spacing-xl);
      padding-bottom: var(--spacing-xl);
      text-align: center;
    }

    .footer__logo {
      justify-self: center;
    }

    .footer__nav-list {
      align-items: center;
    }

    .footer__contact {
      text-align: center;
    }

    .footer__social {
      justify-content: center;
    }

    .footer__bottom-container {
      flex-direction: column;
      text-align: center;
      gap: var(--spacing-md);
    }

    .footer__legal {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .logo-circle {
      width: 60px;
      height: 60px;
    }
  }

  @media (max-width: 1024px) and (min-width: 769px) {
    .footer__container {
      grid-template-columns: auto 1fr;
      gap: var(--spacing-xl);
    }

    .footer__contact {
      grid-column: 1 / -1;
      text-align: left;
    }

    .footer__social {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }
  }
</style>
