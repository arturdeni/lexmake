---
// src/pages/portfolio/[slug].astro
// Ficha de proyecto (estructura de huyml.co): datos a la izquierda, imágenes en el centro
// y miniaturas a la derecha.
import Layout from "../../layouts/Layout.astro";
import { getProjects, displayUrl } from "../../lib/projects";
import { optimizeHygraphImage } from "../../lib/imageUtils";
import type { Project } from "../../types/project";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const title = project.title.replace(/\s+/g, " ").trim();

// Primero las capturas de la web real y después la galería
const images = [...project.webScreenshots, ...project.images];
---

<Layout title={`${title} - Portfolio`} description={project.shortDescription || project.description}>
  <article class="project">
    <h1 class="visually-hidden">{title}</h1>

    <!-- Izquierda: datos del proyecto -->
    <aside class="project__aside text-micro">
      <div class="project__info">
        <div class="project__row">
          <span class="text-muted">Sobre el proyecto</span>
          <p class="project__about">{project.description}</p>
        </div>

        <div class="project__row project__row--split">
          <span class="text-muted">Servicios</span>
          <span>
            {
              project.services.map((service, k) => (
                <>
                  {k > 0 && <br />}
                  {service}
                </>
              ))
            }
          </span>
          {project.sector && <span class="text-muted">Sector</span>}
          {project.sector && <span>{project.sector}</span>}
        </div>

        <div class="project__row">
          <span class="text-muted">Estudio</span>
          <span>Lexmake, Barcelona</span>
        </div>

        {
          project.websiteUrl && (
            <a
              class="arrow-link project__visit"
              href={project.websiteUrl}
              target="_blank"
              rel="noopener"
              aria-label={`Visitar web: ${displayUrl(project.websiteUrl)}`}
            >
              Visitar web →
            </a>
          )
        }
      </div>
      <span class="project__scroll text-muted">Scroll</span>
    </aside>

    <!-- Centro: imágenes -->
    <div class="project__images">
      {
        images.map((image, k) => (
          <figure class="project__figure" id={`imagen-${k + 1}`}>
            <img
              src={optimizeHygraphImage(image.url, { width: 1400, quality: 75 })}
              width={image.width}
              height={image.height}
              alt={`${title}, imagen ${k + 1}`}
              loading={k < 2 ? "eager" : "lazy"}
              decoding="async"
            />
          </figure>
        ))
      }
    </div>

    <!-- Derecha: miniaturas -->
    <nav class="project__map" aria-label="Imágenes del proyecto">
      {
        images.map((image, k) => (
          <button
            type="button"
            class:list={["project__thumb", { "is-active": k === 0 }]}
            data-index={k}
            aria-label={`Ir a la imagen ${k + 1}`}
          >
            <img src={optimizeHygraphImage(image.url, { width: 100, quality: 60 })} alt="" loading="lazy" />
          </button>
        ))
      }
    </nav>
  </article>

  <a class="project__next" href={`/portfolio/${next.slug}`}>
    <span class="arrow-link">Siguiente proyecto →</span>
  </a>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .project {
    display: grid;
    grid-template-columns: 27.5vw 45vw 27.5vw;
    position: relative;
  }

  /* === IZQUIERDA === */
  .project__aside {
    position: sticky;
    top: 0;
    height: 100vh;
    align-self: start;
  }

  .project__info {
    position: absolute;
    left: 20px;
    top: 37vh;
    width: calc(27.5vw - 40px);
    display: grid;
    gap: 46px;
  }

  .project__row {
    display: grid;
    grid-template-columns: 104px 1fr;
    align-items: start;
  }

  .project__row--split {
    grid-template-columns: 104px 108px 56px 1fr;
  }

  .project__about {
    margin: 0;
    max-width: 225px;
    font: inherit;
  }

  .project__visit {
    margin-left: 104px;
  }

  .project__scroll {
    position: absolute;
    left: 20px;
    bottom: 20px;
  }

  /* === CENTRO === */
  .project__images {
    display: flex;
    flex-direction: column;
    gap: 85px;
    padding: 46.6vh 0 22vh;
  }

  .project__figure {
    margin: 0;
    width: 100%;
    background: #dcdcdc;
    overflow: hidden;
  }

  .project__figure img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* === DERECHA === */
  .project__map {
    position: sticky;
    top: 0;
    height: 100vh;
    align-self: start;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
    gap: 7px;
    padding-right: 47px;
  }

  .project__thumb {
    width: 43px;
    height: 31px;
    padding: 0;
    border: 0;
    background: #ddd;
    opacity: 0.35;
    transition: opacity 0.3s;
    cursor: pointer;
    overflow: hidden;
  }

  .project__thumb.is-active,
  .project__thumb:hover {
    opacity: 1;
  }

  .project__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* === SIGUIENTE === */
  .project__next {
    display: flex;
    justify-content: center;
    padding: 40px var(--container-padding) 140px;
    text-decoration: none;
  }

  /* === RESPONSIVE === */
  @media (max-width: 900px) {
    .project {
      grid-template-columns: 1fr;
      padding: 0 var(--container-padding);
    }

    .project__aside {
      position: relative;
      height: auto;
    }

    .project__info {
      position: static;
      width: auto;
      padding: 110px 0 40px;
      gap: 28px;
    }

    .project__row {
      grid-template-columns: 90px 1fr;
    }

    .project__row--split {
      grid-template-columns: 90px 1fr 56px 1fr;
    }

    .project__visit {
      margin-left: 90px;
    }

    .project__scroll,
    .project__map {
      display: none;
    }

    .project__images {
      padding: 0 0 60px;
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .project__info {
      padding-top: 40px;
    }
  }
</style>

<script>
  import { onPage, prefersReducedMotion } from "../../scripts/lifecycle";

  onPage(() => {
    const figures = [...document.querySelectorAll<HTMLElement>(".project__figure")];
    const thumbs = [...document.querySelectorAll<HTMLButtonElement>(".project__thumb")];
    if (!figures.length) return;

    // Clic en una miniatura: scroll hasta esa imagen
    const onThumb = (e: Event) => {
      const k = Number((e.currentTarget as HTMLElement).dataset.index);
      const top = window.scrollY + figures[k].getBoundingClientRect().top - window.innerHeight * 0.466;
      window.scrollTo({ top, behavior: prefersReducedMotion() ? "auto" : "smooth" });
    };
    thumbs.forEach((t) => t.addEventListener("click", onThumb));

    // Se marca la imagen más cercana al centro de la pantalla
    let active = 0;
    let ticking = false;
    const update = () => {
      ticking = false;
      let best = 0;
      let bestDistance = Infinity;
      figures.forEach((f, k) => {
        const r = f.getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - window.innerHeight / 2);
        if (d < bestDistance) {
          bestDistance = d;
          best = k;
        }
      });
      if (best !== active) {
        active = best;
        thumbs.forEach((t, k) => t.classList.toggle("is-active", k === best));
      }
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });

    return () => {
      window.removeEventListener("scroll", onScroll);
      thumbs.forEach((t) => t.removeEventListener("click", onThumb));
    };
  });
</script>
